<figure class="work">
  <img src="<%= w.image || '/img/placeholder.svg' %>" alt="<%= w.title %> – altered <%= w.card %>" loading="lazy">
  <figcaption>
    <strong><%= w.title %></strong>
    <span>Altered <%= w.card %> · <%= w.year %></span>
    <span class="muted"><%= w.medium %></span>
  </figcaption>
</figure>
